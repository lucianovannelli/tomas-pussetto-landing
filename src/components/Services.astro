---
import { CheckCircle2, Calendar, Star, ArrowRight, ShieldCheck, Smartphone, Utensils, PhoneCall, RefreshCw, MessageCircle } from 'lucide-react';

const DELIVERABLES = [
  {
    icon: Smartphone,
    title: "1. Rutina a Medida en App Exclusiva",
    desc: "Planes de fuerza progresiva de 3 horas por semana. Videos de ejecución técnica paso a paso para entrenar con total seguridad en el gimnasio o en tu casa."
  },
  {
    icon: Utensils,
    title: "2. Plan de Alimentación Flexible (Hecho por Nutricionista)",
    desc: "Sin dietas de hambre ni 'dos rodajas de manzana'. Alimentación real para desinflamar, perder grasa y nutrir tus músculos sin renunciar a tus comidas favoritas ni salidas sociales."
  },
  {
    icon: MessageCircle,
    title: "3. Seguimiento 1 a 1 Diario 24/7",
    desc: "Contacto directo por WhatsApp con Tomás Pussetto. Si tu jornada laboral se complica o surge un viaje, reajustamos el plan en minutos sin culpas ni abandonos."
  },
  {
    icon: PhoneCall,
    title: "4. Llamadas de Seguimiento Semanales",
    desc: "Revisión constante de progresos, análisis de tus videos de entrenamiento, control de medidas/fotos y mentoría en psicología del hábito."
  },
  {
    icon: ShieldCheck,
    title: "5. Garantía Incondicional de Resultado (90 Días)",
    desc: "Si aplicás el programa y no bajás entre 8 y 10 kg de grasa ni recuperás tu energía en 90 días, seguimos trabajando totalmente GRATIS hasta que lo logres."
  }
];
---

<section id="entregables" class="section services-section">
  <div class="container">
    <div class="section-header text-center">
      <div class="badge badge-center">
        <Star size={16} fill="#26160D" color="#26160D" />
        <span>Entregables del Programa 90 Días</span>
      </div>
      <h2 class="section-title">
        Todo lo que incluye la <span class="text-espresso">Asesoría Online 1 a 1</span>
      </h2>
      <p class="section-subtitle">
        Una estructura de acompañamiento integral diseñada exclusivamente para mujeres profesionales que necesitan orden, claridad y resultados reales.
      </p>
    </div>

    <div class="deliverables-grid">
      {DELIVERABLES.map((del) => {
        const IconComponent = del.icon;
        return (
          <div class="deliverable-card brand-card-light">
            <div class="del-header">
              <div class="del-icon-box">
                <IconComponent size={22} />
              </div>
            </div>
            <h3 class="del-title">{del.title}</h3>
            <p class="del-desc">{del.desc}</p>
          </div>
        );
      })}
    </div>

    <!-- Main Offer CTA Card -->
    <div id="garantia" class="main-offer-card brand-card-dark">
      <div class="offer-header">
        <div>
          <span class="offer-badge">Cupos Limitados por Mes</span>
          <h3 class="offer-card-title">Programa de Coaching Online de 90 Días</h3>
          <p class="offer-card-subtitle">Exclusivo para mujeres profesionales +30</p>
        </div>
        <div class="offer-guarantee-tag">
          <ShieldCheck size={20} color="#F5F0E8" />
          <span>Garantía de Resultado Incluida</span>
        </div>
      </div>

      <p class="offer-summary-text">
        Fuiste a mil nutris en serie y a entrenadores que no entendieron lo que te pasa en tu rutina real. Este programa no busca darte un PDF genérico: es una mentoría directa con Tomás Pussetto para transformar tu cuerpo y hábitos para siempre.
      </p>

      <div class="offer-action-box">
        <a 
          href="https://calendly.com/tomaspussetto43/reunion-de-consultoria-gratuita" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg btn-offer-cta"
        >
          <Calendar size={22} />
          <span>📅 Agendar mi Reunión de Consultoría Gratuita (Calendly)</span>
          <ArrowRight size={20} />
        </a>
        <p class="guarantee-microtext">
          🔒 Trabajo con un número limitado de alumnas en paralelo para garantizar seguimiento diario 1 a 1 de máxima calidad.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    position: relative;
    background-color: var(--color-creme);
  }

  .text-center {
    text-align: center;
  }

  .badge-center {
    margin: 0 auto 1rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-obsidian);
  }

  .section-subtitle {
    font-size: 1.15rem;
    color: var(--color-creme-muted);
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }

  .deliverables-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .deliverable-card {
    padding: 2rem;
    background: #FFFFFF;
    border: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
  }

  .del-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-creme);
    border: 1px solid var(--border-light);
    color: var(--color-espresso);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .del-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    color: var(--color-obsidian);
  }

  .del-desc {
    font-size: 0.95rem;
    color: var(--color-creme-muted);
    line-height: 1.55;
  }

  /* Main Offer CTA Card */
  .main-offer-card {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem;
    background: var(--color-espresso);
    border: 1px solid var(--border-dark);
    box-shadow: 0 25px 50px rgba(38, 22, 13, 0.2);
  }

  .offer-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-dark);
  }

  .offer-badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-obsidian);
    background: var(--color-creme);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  .offer-card-title {
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--color-creme);
  }

  .offer-card-subtitle {
    font-size: 1rem;
    color: var(--color-creme-muted);
    margin-top: 0.2rem;
  }

  .offer-guarantee-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(245, 240, 232, 0.08);
    border: 1px solid var(--border-dark);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-creme);
  }

  .offer-summary-text {
    font-size: 1.1rem;
    color: var(--color-creme-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .offer-action-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-offer-cta {
    width: 100%;
    justify-content: center;
    padding: 1.25rem 2rem;
    font-size: 1.1rem;
  }

  .guarantee-microtext {
    font-size: 0.85rem;
    color: var(--color-creme-muted);
    text-align: center;
  }

  @media (max-width: 900px) {
    .deliverables-grid {
      grid-template-columns: 1fr;
    }
    .offer-header {
      flex-direction: column;
    }
    .main-offer-card {
      padding: 2rem 1.5rem;
    }
  }
</style>
