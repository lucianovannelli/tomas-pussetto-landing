---
import { MessageCircle, Menu } from 'lucide-react';
---

<header class="header">
  <div class="container header-container">
    <a href="#" class="brand-logo-link">
      <img 
        src="/logo-signature-dark-clean.png" 
        alt="Tomás Pussetto - Coach Online para Mujeres" 
        class="header-signature-logo"
      />
    </a>

    <nav class="nav-desktop">
      <a href="#programa" class="nav-link">Programa 90 Días</a>
      <a href="#entregables" class="nav-link">Qué Incluye</a>
      <a href="#quiz" class="nav-link">Test Adherencia</a>
      <a href="#historias" class="nav-link">Casos Reales</a>
      <a href="#garantia" class="nav-link">Garantía</a>
    </nav>

    <div class="header-actions">
      <a 
        href="https://wa.me/5493410000000?text=Hola%20Tomás!%20Soy%20mujer%20profesional%20y%20quiero%20información%20sobre%20tu%20Programa%20Online%20de%2090%20Días" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn-primary btn-nav"
      >
        <MessageCircle size={18} />
        <span>Postular al Programa</span>
      </a>
      
      <button class="mobile-toggle" aria-label="Abrir menú" id="menuToggle">
        <Menu size={24} />
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Nav -->
  <div class="mobile-drawer" id="mobileDrawer">
    <nav class="nav-mobile">
      <a href="#programa" class="mobile-link">Programa 90 Días</a>
      <a href="#entregables" class="mobile-link">Qué Incluye</a>
      <a href="#quiz" class="mobile-link">Test Adherencia</a>
      <a href="#historias" class="mobile-link">Casos Reales</a>
      <a href="#garantia" class="mobile-link">Garantía</a>
      <a 
        href="https://wa.me/5493410000000?text=Hola%20Tomás!%20Soy%20mujer%20profesional%20y%20quiero%20información%20sobre%20tu%20Programa%20Online%20de%2090%20Días" 
        target="_blank" 
        rel="noopener noreferrer"
        class="btn btn-primary btn-mobile-cta"
      >
        <MessageCircle size={20} />
        <span>Postular por WhatsApp</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menuToggle');
  const drawer = document.getElementById('mobileDrawer');
  const links = document.querySelectorAll('.mobile-link');

  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      drawer.classList.toggle('active');
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('active');
      });
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(245, 240, 232, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-light);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 85px;
  }

  .brand-logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .header-signature-logo {
    height: 58px;
    width: auto;
    object-fit: contain;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    color: var(--color-espresso);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: opacity 0.2s ease;
  }

  .nav-link:hover {
    opacity: 0.7;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .btn-nav {
    padding: 0.65rem 1.3rem;
    font-size: 0.9rem;
  }

  .mobile-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--color-espresso);
    cursor: pointer;
    padding: 0.5rem;
  }

  .mobile-drawer {
    display: none;
    position: fixed;
    top: 85px;
    left: 0;
    right: 0;
    background: var(--color-creme);
    border-bottom: 1px solid var(--border-light);
    padding: 1.5rem;
    transform: translateY(-100%);
    opacity: 0;
    transition: all 0.3s ease;
    pointer-events: none;
  }

  .mobile-drawer.active {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .nav-mobile {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mobile-link {
    color: var(--color-obsidian);
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .btn-mobile-cta {
    width: 100%;
    margin-top: 0.5rem;
  }

  @media (max-width: 900px) {
    .nav-desktop {
      display: none;
    }
    .mobile-toggle {
      display: block;
    }
    .mobile-drawer {
      display: block;
    }
    .btn-nav {
      display: none;
    }
  }
</style>
