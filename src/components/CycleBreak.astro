---
import { XCircle, CheckCircle2, RefreshCw } from 'lucide-react';
---

<section id="ciclo" class="section cycle-section">
  <div class="container">
    <div class="section-header text-center">
      <div class="badge badge-center">
        <RefreshCw size={16} />
        <span>Rompé el patrón</span>
      </div>
      <h2 class="section-title">
        Basta de vivir en el ciclo de <span class="text-muted">empezar y abandonar</span>
      </h2>
      <p class="section-subtitle">
        La mayoría de los programas fracasan porque exigen una intensidad insostenible en lugar de construir adherencia real.
      </p>
    </div>

    <div class="cycle-grid">
      <!-- Old Broken Cycle -->
      <div class="cycle-card broken-card brand-card-dark">
        <div class="cycle-card-header">
          <div class="status-icon status-broken">
            <XCircle size={24} />
          </div>
          <div>
            <h3 class="cycle-card-title">El Viejo Ciclo de Culpa</h3>
            <span class="cycle-card-sub">Lo que viviste hasta hoy</span>
          </div>
        </div>

        <ul class="cycle-steps">
          <li class="step-item step-broken">
            <span class="step-num">1</span>
            <div>
              <strong>Empiezas por motivación pasajera</strong>
              <p>Arrancas al 200% esperando resultados en 7 días.</p>
            </div>
          </li>
          <li class="step-item step-broken">
            <span class="step-num">2</span>
            <div>
              <strong>Sobreexigencia y restricciones</strong>
              <p>Rutinas interminables y restricciones drásticas.</p>
            </div>
          </li>
          <li class="step-item step-broken">
            <span class="step-num">3</span>
            <div>
              <strong>Surge la primera complicación</strong>
              <p>Trabajo, viajes o cansancio rompen el plan perfecto.</p>
            </div>
          </li>
          <li class="step-item step-broken">
            <span class="step-num">4</span>
            <div>
              <strong>Abandono y frustración</strong>
              <p>Aparece la culpa y la sensación de haber fallado.</p>
            </div>
          </li>
        </ul>
      </div>

      <!-- New Sustainable Cycle (Creme Card Accent) -->
      <div class="cycle-card sustainable-card brand-card-creme">
        <div class="cycle-card-header">
          <div class="status-icon status-sustainable">
            <CheckCircle2 size={24} />
          </div>
          <div>
            <h3 class="cycle-card-title text-espresso">El Método Tomás Pussetto</h3>
            <span class="cycle-card-sub text-espresso">Adherencia y Hábitos Sostenibles</span>
          </div>
        </div>

        <ul class="cycle-steps">
          <li class="step-item step-sustainable">
            <span class="step-num step-num-dark">1</span>
            <div>
              <strong class="text-espresso">Empiezas con un plan adaptado a tu vida</strong>
              <p class="text-espresso">Diseñado acorde a tus horarios reales y nivel inicial.</p>
            </div>
          </li>
          <li class="step-item step-sustainable">
            <span class="step-num step-num-dark">2</span>
            <div>
              <strong class="text-espresso">Foco en la continuidad, no en la intensidad</strong>
              <p class="text-espresso">Entrenamiento de fuerza simple y efectivo.</p>
            </div>
          </li>
          <li class="step-item step-sustainable">
            <span class="step-num step-num-dark">3</span>
            <div>
              <strong class="text-espresso">Flexibilidad ante imprevistos</strong>
              <p class="text-espresso">Si la rutina cambia, ajustamos sin culpa ni abandono.</p>
            </div>
          </li>
          <li class="step-item step-sustainable">
            <span class="step-num step-num-dark">4</span>
            <div>
              <strong class="text-espresso">Resultados sólidos y autoconfianza</strong>
              <p class="text-espresso">Aprendés a cumplirte la palabra a vos mismo.</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cycle-section {
    position: relative;
  }

  .text-center {
    text-align: center;
  }

  .badge-center {
    margin: 0 auto 1rem;
  }

  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .section-subtitle {
    font-size: 1.15rem;
    color: var(--color-creme-muted);
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }

  .cycle-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .cycle-card {
    padding: 2.5rem;
    position: relative;
    overflow: hidden;
  }

  .broken-card {
    border-color: rgba(239, 68, 68, 0.25);
    background: var(--color-espresso);
  }

  .sustainable-card {
    background: var(--color-creme);
    color: var(--color-espresso);
  }

  .cycle-card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(28, 26, 23, 0.12);
    margin-bottom: 1.75rem;
  }

  .status-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .status-broken {
    background: rgba(239, 68, 68, 0.15);
    color: #F87171;
  }

  .status-sustainable {
    background: var(--color-espresso);
    color: var(--color-creme);
  }

  .cycle-card-title {
    font-size: 1.35rem;
    font-weight: 800;
  }

  .cycle-card-sub {
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .cycle-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .step-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .step-num {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .step-broken .step-num {
    background: rgba(239, 68, 68, 0.15);
    color: #F87171;
  }

  .step-num-dark {
    background: var(--color-espresso);
    color: var(--color-creme);
  }

  .step-item strong {
    display: block;
    font-size: 1rem;
    margin-bottom: 0.2rem;
  }

  .step-item p {
    font-size: 0.9rem;
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .cycle-grid {
      grid-template-columns: 1fr;
    }
    .section-title {
      font-size: 2rem;
    }
  }
</style>
