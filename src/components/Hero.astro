---
import { ArrowRight, CheckCircle2, ShieldCheck, PlayCircle, MessageCircle } from 'lucide-react';
---

<section id="programa" class="hero-vsl-section">
  <div class="container hero-vsl-container">
    
    <!-- Top Announcement Badge -->
    <div class="vsl-badge">
      <PlayCircle size={16} class="vsl-badge-icon" />
      <span>Programa 90 Días • Mujeres Profesionales +30</span>
    </div>

    <!-- Main Headline -->
    <h1 class="vsl-title">
      Bajá entre 8 y 10 kg de grasa, recuperá tu energía y volvé a
      <span class="vsl-highlight">sentirte segura con tu cuerpo en 90 Días.</span>
    </h1>

    <p class="vsl-subtitle">
      Sin dietas de hambre, sin matarte a cardio y entrenando solo <strong>3 horas por semana</strong>. Mirá el video a continuación para conocer el método:
    </p>

    <!-- Video Centerpiece -->
    <div class="vsl-video-wrapper brand-card-dark">
      <div class="video-header-bar">
        <div class="video-bar-dots">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>
        <span class="video-bar-title">Video Explicativo</span>
      </div>

      <div class="video-container">
        <video 
          controls 
          preload="metadata" 
          playsinline 
          class="vsl-video-element"
        >
          <source src="/vsl-tomas-pussetto.mp4" type="video/mp4" />
          Tu navegador no soporta el reproductor de video.
        </video>
      </div>

      <div class="video-footer-banner">
        <ShieldCheck size={20} color="#F5F0E8" />
        <span>Garantía Incondicional: Lográs tu meta en 90 días o seguimos trabajando GRATIS.</span>
      </div>
    </div>

    <!-- Action Buttons below Video -->
    <div class="vsl-actions-wrapper">
      <a href="#quiz" class="btn btn-primary btn-lg vsl-btn-main">
        <span>Hacer Test de Adherencia (1 min)</span>
        <ArrowRight size={22} />
      </a>
      
      <a 
        href="https://wa.me/5493410000000?text=Hola!%20Vi%20tu%20video%20y%20quiero%20información%20sobre%20el%20Programa%20Online%20de%2090%20Días" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="btn btn-secondary btn-lg vsl-btn-sub"
      >
        <MessageCircle size={20} />
        <span>Postular por WhatsApp Directo</span>
      </a>
    </div>

    <!-- Proof Bullets Row -->
    <div class="vsl-proof-row">
      <div class="proof-chip">
        <CheckCircle2 size={16} class="proof-chip-icon" />
        <span>Sin dietas restrictivas ni rebote</span>
      </div>
      <div class="proof-chip">
        <CheckCircle2 size={16} class="proof-chip-icon" />
        <span>Solo 3 hs/semana de fuerza</span>
      </div>
      <div class="proof-chip">
        <CheckCircle2 size={16} class="proof-chip-icon" />
        <span>Seguimiento 1 a 1 diario 24/7</span>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-vsl-section {
    position: relative;
    padding: 3.5rem 0 5rem;
    background-color: var(--color-creme);
    text-align: center;
  }

  .hero-vsl-container {
    max-width: 920px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vsl-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.1rem;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--color-creme-dark);
    border: 1px solid var(--border-light);
    color: var(--color-espresso);
    margin-bottom: 1.25rem;
  }

  .vsl-badge-icon {
    color: var(--color-espresso);
  }

  .vsl-title {
    font-size: 2.8rem;
    font-weight: 800;
    line-height: 1.18;
    color: var(--color-obsidian);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .vsl-highlight {
    display: block;
    color: var(--color-espresso);
    font-weight: 800;
    margin-top: 0.3rem;
  }

  .vsl-subtitle {
    font-size: 1.18rem;
    color: var(--color-creme-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
    max-width: 720px;
  }

  .vsl-subtitle strong {
    color: var(--color-obsidian);
  }

  /* VSL Video Wrapper */
  .vsl-video-wrapper {
    width: 100%;
    max-width: 860px;
    background: var(--color-espresso);
    border: 2px solid var(--color-espresso);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(38, 22, 13, 0.25);
    margin-bottom: 2.5rem;
  }

  .video-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    background: #1C1A17;
    border-bottom: 1px solid var(--border-dark);
  }

  .video-bar-dots {
    display: flex;
    gap: 0.4rem;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #FF5F56; }
  .dot-yellow { background: #FFBD2E; }
  .dot-green { background: #27C93F; }

  .video-bar-title {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-creme-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .video-container {
    position: relative;
    width: 100%;
    background: #000000;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vsl-video-element {
    width: 100%;
    height: 100%;
    object-fit: contain;
    outline: none;
  }

  .video-footer-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 0.85rem 1.25rem;
    background: var(--color-espresso);
    color: var(--color-creme);
    font-size: 0.9rem;
    font-weight: 700;
    border-top: 1px solid var(--border-dark);
  }

  /* Actions below VSL */
  .vsl-actions-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
    margin-bottom: 2rem;
  }

  .vsl-btn-main {
    padding: 1.15rem 2.2rem;
    font-size: 1.15rem;
    box-shadow: 0 10px 30px rgba(38, 22, 13, 0.3);
  }

  .vsl-btn-sub {
    padding: 1.15rem 2rem;
    font-size: 1.05rem;
  }

  /* Proof Row */
  .vsl-proof-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  .proof-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    background: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-obsidian);
  }

  .proof-chip-icon {
    color: var(--color-espresso);
  }

  @media (max-width: 768px) {
    .vsl-title {
      font-size: 2rem;
    }
    .vsl-subtitle {
      font-size: 1.05rem;
    }
    .vsl-actions-wrapper {
      flex-direction: column;
      width: 100%;
    }
    .vsl-btn-main, .vsl-btn-sub {
      width: 100%;
      justify-content: center;
    }
  }
</style>
