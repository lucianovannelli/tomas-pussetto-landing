---
import { ArrowRight, CheckCircle2, ShieldCheck, Zap, Globe } from 'lucide-react';
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="badge">
        <span class="badge-dot"></span>
        <span>Rosario & Coaching Online</span>
        <Globe size={15} class="inline-badge-icon" />
      </div>

      <h1 class="hero-title">
        El gimnasio no es para cambiar tu cuerpo.
        <span class="hero-highlight">Es donde aprendés a cumplirte la palabra.</span>
      </h1>

      <p class="hero-subtitle">
        Te enseño a convertir el entrenamiento de fuerza en un hábito sostenible que <strong>no abandones nunca más</strong>. Sin culpas, sin sobreexigencia y adaptado a tu vida real.
      </p>

      <div class="hero-actions">
        <a href="#quiz" class="btn btn-primary btn-lg">
          <span>Hacer Test de Adherencia (1 min)</span>
          <ArrowRight size={20} />
        </a>
        <a 
          href="https://wa.me/5493410000000?text=Hola%20Tomás,%20quiero%20conocer%20tu%20método%20de%20entrenamiento%20y%20hábitos" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary btn-lg"
        >
          <span>Agendar por WhatsApp</span>
        </a>
      </div>

      <div class="hero-proof-list">
        <div class="proof-item">
          <CheckCircle2 size={18} class="proof-icon" />
          <span>Sin rutinas imposibles</span>
        </div>
        <div class="proof-item">
          <CheckCircle2 size={18} class="proof-icon" />
          <span>Foco en sostener el proceso</span>
        </div>
        <div class="proof-item">
          <CheckCircle2 size={18} class="proof-icon" />
          <span>Acompañamiento 1 a 1 directo</span>
        </div>
      </div>
    </div>

    <!-- Hero Visual / Brand Manifesto Card -->
    <div class="hero-visual">
      <div class="hero-card brand-card-dark">
        <div class="card-brand-header">
          <img 
            src="/logo-signature-creme.png" 
            alt="Tomás Pussetto" 
            class="card-signature-img"
          />
        </div>
        
        <blockquote class="card-quote">
          "No busques intensidad desmedida en la primera semana. Buscá la continuidad que vas a sostener dentro de 5 años."
        </blockquote>

        <div class="card-stats-grid">
          <div class="stat-box">
            <span class="stat-num">+100</span>
            <span class="stat-label">Alumnos asistidos</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">4 Pilares</span>
            <span class="stat-label">Método Integral</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">100%</span>
            <span class="stat-label">Adherencia Real</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 4.5rem 0 5.5rem;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-creme);
  }

  .hero-title {
    font-size: 2.9rem;
    font-weight: 800;
    line-height: 1.16;
    margin: 1.5rem 0 1.25rem;
    letter-spacing: -0.01em;
  }

  .hero-highlight {
    display: block;
    color: var(--color-creme-muted);
    font-weight: 700;
    margin-top: 0.3rem;
  }

  .hero-subtitle {
    font-size: 1.18rem;
    color: var(--color-creme-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 620px;
  }

  .hero-subtitle strong {
    color: var(--color-creme);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .hero-proof-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-warm);
    width: 100%;
  }

  .proof-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-creme-muted);
  }

  .proof-icon {
    color: var(--color-creme);
  }

  /* Visual Card */
  .hero-visual {
    position: relative;
  }

  .hero-card {
    padding: 2.5rem;
    background: var(--color-espresso);
    border: 1px solid var(--border-warm);
  }

  .card-brand-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-warm);
  }

  .card-signature-img {
    height: 64px;
    width: auto;
    object-fit: contain;
    align-self: flex-start;
  }

  .card-tagline {
    font-size: 0.72rem;
    color: var(--color-creme-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 4px;
  }

  .card-quote {
    font-size: 1.2rem;
    font-style: italic;
    color: var(--color-creme);
    line-height: 1.55;
    margin-bottom: 2rem;
  }

  .card-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-warm);
  }

  .stat-box {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-creme);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-creme-muted);
    margin-top: 2px;
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-title {
      font-size: 2.3rem;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 1.9rem;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-lg {
      width: 100%;
    }
  }
</style>
