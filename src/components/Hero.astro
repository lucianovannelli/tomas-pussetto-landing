---
import { ArrowRight, CheckCircle2, ShieldCheck, Sparkles } from 'lucide-react';
---

<section id="programa" class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="badge">
        <Sparkles size={15} />
        <span>Coaching Online 100% Personalizado</span>
      </div>

      <h1 class="hero-title">
        Bajá entre 8 y 10 kg de grasa, recuperá tu energía y volvé a
        <span class="hero-highlight">sentirte segura con tu cuerpo en 90 Días.</span>
      </h1>

      <p class="hero-subtitle">
        Entrenando solo <strong>3 horas por semana</strong>, sin privarte de los alimentos que te gustan ni matarte a cardio. Un programa diseñado exclusivamente para mujeres profesionales con agendas exigentes.
      </p>

      <div class="hero-actions">
        <a href="#quiz" class="btn btn-primary btn-lg">
          <span>Hacer Test de Adherencia (1 min)</span>
          <ArrowRight size={20} />
        </a>
        <a 
          href="https://wa.me/5493410000000?text=Hola%20Tomás!%20Soy%20mujer%20profesional%20y%20quiero%20conocer%20tu%20Programa%20Online%20de%2090%20Días" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn btn-secondary btn-lg"
        >
          <span>Consultar Cupos por WhatsApp</span>
        </a>
      </div>

      <div class="hero-proof-list">
        <div class="proof-item">
          <CheckCircle2 size={18} class="proof-icon" />
          <span>Sin dietas de hambre</span>
        </div>
        <div class="proof-item">
          <CheckCircle2 size={18} class="proof-icon" />
          <span>Solo 3 hs/semana de fuerza</span>
        </div>
        <div class="proof-item">
          <CheckCircle2 size={18} class="proof-icon" />
          <span>Garantía de Resultado en 90 Días</span>
        </div>
      </div>
    </div>

    <!-- Hero Visual / Offer Guarantee Card (Dark Espresso Contrast) -->
    <div class="hero-visual">
      <div class="hero-card brand-card-dark">
        <div class="card-brand-header">
          <img 
            src="/logo-signature-creme.png" 
            alt="Tomás Pussetto" 
            class="card-signature-img"
          />
        </div>

        <div class="offer-guarantee-box">
          <ShieldCheck size={26} color="#F5F0E8" class="guarantee-shield" />
          <div>
            <h3 class="guarantee-title">Garantía Incondicional</h3>
            <p class="guarantee-text">
              Lográs tu resultado en 90 días o seguimos trabajando <strong>GRATIS</strong> hasta que lo consigas. Sin preguntas ni letra chica.
            </p>
          </div>
        </div>
        
        <blockquote class="card-quote">
          "No te falta fuerza de voluntad. Te falta un plan que no te haga pasar hambre y se adapte al caos de tu rutina profesional."
        </blockquote>

        <div class="card-stats-grid">
          <div class="stat-box">
            <span class="stat-num">90 Días</span>
            <span class="stat-label">Programa Intensivo</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">8-10 kg</span>
            <span class="stat-label">Menos de Grasa</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">3 hs/sem</span>
            <span class="stat-label">Fuerza Eficiente</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 4.5rem 0 5.5rem;
    background-color: var(--color-creme);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-title {
    font-size: 2.8rem;
    font-weight: 800;
    line-height: 1.16;
    margin: 1.5rem 0 1.25rem;
    letter-spacing: -0.01em;
    color: var(--color-obsidian);
  }

  .hero-highlight {
    display: block;
    color: var(--color-espresso);
    font-weight: 800;
    margin-top: 0.3rem;
  }

  .hero-subtitle {
    font-size: 1.18rem;
    color: var(--color-creme-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 620px;
  }

  .hero-subtitle strong {
    color: var(--color-obsidian);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .hero-proof-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-light);
    width: 100%;
  }

  .proof-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-obsidian);
    font-weight: 600;
  }

  .proof-icon {
    color: var(--color-espresso);
  }

  /* Visual Card (Espresso Accent) */
  .hero-visual {
    position: relative;
  }

  .hero-card {
    padding: 2.5rem;
    background: var(--color-espresso);
    border: 1px solid var(--border-dark);
  }

  .card-brand-header {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-dark);
  }

  .card-signature-img {
    height: 64px;
    width: auto;
    object-fit: contain;
    align-self: flex-start;
  }

  .offer-guarantee-box {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    background: rgba(245, 240, 232, 0.08);
    border: 1px solid var(--border-dark);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }

  .guarantee-shield {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .guarantee-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-creme);
    margin-bottom: 0.2rem;
  }

  .guarantee-text {
    font-size: 0.88rem;
    color: var(--color-creme-muted);
    line-height: 1.45;
  }

  .guarantee-text strong {
    color: var(--color-creme);
  }

  .card-quote {
    font-size: 1.1rem;
    font-style: italic;
    color: var(--color-creme);
    line-height: 1.5;
    margin-bottom: 1.75rem;
  }

  .card-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-dark);
  }

  .stat-box {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-creme);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-creme-muted);
    margin-top: 2px;
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-title {
      font-size: 2.3rem;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 1.9rem;
    }
    
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-lg {
      width: 100%;
    }
  }
</style>
