---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import CycleBreak from '../components/CycleBreak.astro';
import QuizInteractive from '../components/QuizInteractive.jsx';
import Pillars from '../components/Pillars.astro';
import TransformationSlider from '../components/TransformationSlider.jsx';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
import VSLModalOverlay from '../components/VSLModalOverlay.jsx';
---

<Layout>
  <!-- Auto VSL Pop-up Modal Overlay for High Conversion -->
  <VSLModalOverlay client:only="react" />

  <Header />

  <main>
    <Hero />
    
    <section class="section">
      <div class="container">
        <QuizInteractive client:visible />
      </div>
    </section>

    <CycleBreak />

    <Pillars />

    <section id="historias" class="section">
      <div class="container">
        <div class="section-header text-center">
          <div class="badge badge-center">
            <span>Resultados Reales</span>
          </div>
          <h2 class="section-title">
            Historias de <span class="text-espresso">Mujeres Profesionales</span>
          </h2>
          <p class="section-subtitle">
            Alumnas reales que lograron romper el ciclo de empezar y abandonar, recuperando su energía, autoconfianza y salud hormonal.
          </p>
        </div>

        <TransformationSlider client:visible />
      </div>
    </section>

    <Services />

    <About />

    <FAQ />
  </main>

  <Footer />
</Layout>

<style>
  .text-center {
    text-align: center;
  }
  .badge-center {
    margin: 0 auto 1rem;
  }
  .section-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
    color: var(--color-obsidian);
  }
  .section-subtitle {
    font-size: 1.15rem;
    color: var(--color-creme-muted);
    max-width: 680px;
    margin: 0 auto 3.5rem;
  }
</style>
